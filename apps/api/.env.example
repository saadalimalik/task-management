NODE_ENV=development
PORT=3000
# Local dev connects to the compose Postgres through localhost.
# Inside docker compose this value is overridden to point at the postgres service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_management?schema=public
LOG_LEVEL=http
# "*" or a comma-separated list of allowed origins
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Reverse proxies in front of the API whose X-Forwarded-For header is trusted (0 = none).
TRUST_PROXY=0
# Shared secret between the web app and the API. Must be the same value in apps/api/.env and
# apps/web/.env, at least 32 characters. Generate one with: openssl rand -hex 32
# Leave empty to turn per-user rate limiting off (every web user then shares one limit).
INTERNAL_PROXY_SECRET=
