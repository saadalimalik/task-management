{
    "name": "web",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "start": "node .output/server/index.mjs",
        "check-types": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "test": "vitest run",
        "api:types": "pnpm --package=openapi-typescript@7.13.0 --package=typescript@5.9.3 dlx openapi-typescript ${API_URL:-http://localhost:3000}/openapi.json --output src/types/api.gen.ts"
    },
    "dependencies": {
        "@fontsource-variable/outfit": "5.3.0",
        "@tanstack/react-query": "5.108.0",
        "@tanstack/react-router": "1.170.46",
        "@tanstack/react-router-ssr-query": "1.167.3",
        "@tanstack/react-start": "1.169.7",
        "dotenv": "18.0.10",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "sonner": "2.0.8",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@tailwindcss/vite": "4.3.5",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "8.0.0",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.13",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.3.0",
        "eslint": "10.15.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "jsdom": "31.0.1",
        "nitro": "3.0.261103-rc",
        "tailwindcss": "4.3.5",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    }
}
