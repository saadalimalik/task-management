# Base URL of the tasks REST API, called from the web server only.
# Inside docker compose this value is overridden to point at the api service.
API_URL=http://localhost:3000
# Public origin of this site, used for canonical URLs, sitemap and robots.txt.
SITE_URL=http://localhost:3001
# Shared secret between the web app and the API. Must be the same value in apps/api/.env and
# apps/web/.env, at least 32 characters. Generate one with: openssl rand -hex 32
# Leave empty to turn per-user rate limiting off (every web user then shares one limit).
INTERNAL_PROXY_SECRET=
